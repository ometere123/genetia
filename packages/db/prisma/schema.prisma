generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas   = ["genetia_app"]
}

enum MarketEngine {
  POOL
  LMSR
  @@schema("genetia_app")
}

enum MarketStatus {
  PROPOSED
  ADMISSIBILITY
  REVISION
  APPROVED
  FUNDING
  ACTIVE
  CLOSED
  RESOLVING
  TERMINAL
  EXPIRED
  FUNDING_FAILED
  @@schema("genetia_app")
}

enum ResolutionReason {
  EVIDENCE
  TECHNICAL
  @@schema("genetia_app")
}

enum TerminalOutcome {
  YES
  NO
  VOID
  @@schema("genetia_app")
}


model User {
  id          String   @id @default(uuid()) @db.Uuid
  privyUserId String   @unique
  displayName String?
  avatarUrl   String?
  wallets     Wallet[]
  proposals   Proposal[]
  apiKeys     ApiKey[]
  notifications Notification[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@schema("genetia_app")
}

model Wallet {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  chainId   Int
  address   String
  kind      String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([chainId, address])
  @@index([userId])
  @@schema("genetia_app")
}

model Market {
  id                        String @id @default(uuid()) @db.Uuid
  marketId                  String @unique
  engine                    MarketEngine
  creatorAddress            String
  creatorUserId             String? @db.Uuid
  title                     String
  question                  String
  description               String
  category                  String
  status                    MarketStatus
  financialReleaseId        String
  resolverReleaseId         String
  gatewayReleaseId          String
  baseChainId               Int @default(84532)
  baseAddress               String @unique
  collateralAddress         String
  deploymentBlock           BigInt
  genlayerChainId           Int @default(61997)
  resolverAddress           String
  genlayerDeploymentEpoch   String
  manifestJson              Json
  manifestHash              String
  closeTime                 DateTime
  resolutionAvailableTime   DateTime
  terminalDeadline          DateTime
  currentResolutionAttempt  Int @default(0)
  finalizedResolutionTxId   String?
  terminalOutcome           TerminalOutcome?
  poolYesTotal              Decimal? @db.Decimal(78, 0)
  poolNoTotal               Decimal? @db.Decimal(78, 0)
  lmsrB                     Decimal? @db.Decimal(78, 0)
  lmsrFundingTarget         Decimal? @db.Decimal(78, 0)
  indexedExposure           Decimal @default(0) @db.Decimal(78, 0)
  proposals                 Proposal[]
  attempts                  ResolutionAttempt[]
  evidence                  Evidence[]
  attestations              WatcherAttestation[]
  trades                    Trade[]
  liquidity                 LiquidityActivity[]
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  @@index([status, closeTime])
  @@index([category, createdAt])
  @@schema("genetia_app")
}

model Proposal {
  id              String @id @default(uuid()) @db.Uuid
  proposerUserId  String @db.Uuid
  marketId        String? @db.Uuid
  proposalKey     String @unique
  revision        Int @default(0)
  canonicalTerms  Json
  bondTxHash      String @unique
  bondAmount      Decimal @db.Decimal(78, 0)
  decision        String?
  bondDisposition String?
  proposer        User @relation(fields: [proposerUserId], references: [id])
  market          Market? @relation(fields: [marketId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@schema("genetia_app")
}

model ResolutionAttempt {
  id                  String @id @default(uuid()) @db.Uuid
  marketId            String @db.Uuid
  attemptNo           Int
  reason              ResolutionReason
  idempotencyKey      String @unique
  genlayerTxId        String? @unique
  lifecycle           String
  executionStatus     String?
  candidateOutcome    String?
  resultCommitment    String?
  evidenceJson        Json?
  errorClassification String?
  retryDueAt          DateTime?
  submittedAt         DateTime?
  finalizedAt         DateTime?
  market              Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  @@unique([marketId, attemptNo, reason])
  @@index([lifecycle, retryDueAt])
  @@schema("genetia_app")
}

model Evidence {
  id              String @id @default(uuid()) @db.Uuid
  marketId        String @db.Uuid
  attemptNo       Int
  sourceIdentity  String
  url             String
  normalizedFacts Json
  fetchedAt       DateTime
  freshnessAt     DateTime?
  commitment      String
  market          Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  @@unique([marketId, attemptNo, sourceIdentity, url])
  @@schema("genetia_app")
}

model WatcherAttestation {
  id               String @id @default(uuid()) @db.Uuid
  marketId         String @db.Uuid
  watcherId        String
  watcherAddress   String
  genlayerTxId     String
  resultCommitment String
  outcome          TerminalOutcome
  signature        String
  createdAt        DateTime @default(now())
  market           Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  @@unique([marketId, genlayerTxId, watcherAddress])
  @@index([genlayerTxId, resultCommitment])
  @@schema("genetia_app")
}

model ChainEvent {
  id              String @id @default(uuid()) @db.Uuid
  chainId         Int
  transactionHash String
  logIndex        Int
  blockNumber     BigInt
  blockHash       String
  transactionIndex Int?
  contractAddress String
  eventName       String
  payload         Json
  canonical       Boolean @default(true)
  indexedAt       DateTime @default(now())
  @@unique([chainId, transactionHash, logIndex])
  @@index([chainId, blockNumber, logIndex])
  @@schema("genetia_app")
}

model Trade {
  id              String @id @default(uuid()) @db.Uuid
  marketId        String @db.Uuid
  chainEventId    String @unique @db.Uuid
  transactionHash String
  walletAddress   String
  action          String
  side            String
  shares          Decimal @db.Decimal(78, 0)
  notional        Decimal @db.Decimal(78, 0)
  fee             Decimal @db.Decimal(78, 0)
  blockNumber     BigInt
  market          Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  @@index([marketId, walletAddress])
  @@schema("genetia_app")
}

model LiquidityActivity {
  id              String @id @default(uuid()) @db.Uuid
  marketId        String @db.Uuid
  chainEventId    String @unique @db.Uuid
  transactionHash String
  walletAddress   String
  action          String
  assets          Decimal @db.Decimal(78, 0)
  shares          Decimal @db.Decimal(78, 0)
  blockNumber     BigInt
  market          Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  @@index([marketId, walletAddress])
  @@schema("genetia_app")
}

model Notification {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @db.Uuid
  type           String
  dedupeKey      String @unique
  payload        Json
  deliveredAt    DateTime?
  acknowledgedAt DateTime?
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  @@schema("genetia_app")
}

model ApiKey {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @db.Uuid
  keyHash     String @unique
  label       String
  scopes      String[]
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  @@schema("genetia_app")
}

model CostAccounting {
  id             String @id @default(uuid()) @db.Uuid
  operationKey   String @unique
  walletAddress  String?
  category       String
  amountUsdMicros BigInt
  sponsoredOps   Int @default(0)
  occurredAt     DateTime
  metadata       Json?
  @@index([walletAddress, occurredAt])
  @@index([category, occurredAt])
  @@schema("genetia_app")
}

model IndexerCursor {
  chainId          Int @id
  deploymentBlock  BigInt
  nextBlock         BigInt
  lastBlockHash     String?
  updatedAt         DateTime @updatedAt
  @@schema("genetia_app")
}

model WorkflowState {
  idempotencyKey String @id
  workflowType   String
  externalId     String?
  state          String
  payload        Json
  attempts       Int @default(0)
  nextRunAt      DateTime?
  deadLetteredAt DateTime?
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([state, nextRunAt])
  @@schema("genetia_app")
}

/// Rebuildable query projection. It is never a source of truth for funds.
model DerivedProjection {
  projectionKey String   @id
  kind          String
  marketId      String?
  walletAddress String?
  payload       Json
  updatedAt     DateTime @updatedAt
  @@index([kind, marketId])
  @@index([walletAddress, kind])
  @@schema("genetia_app")
}
